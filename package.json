{
  "name": "reading-library",
  "version": "1.0.0",
  "description": "Personal reading library — track series, volumes, and characters",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "audit": "npm audit --omit=dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "build": {
    "appId": "com.maomao.myaarchive",
    "productName": "Myaarchive",
    "files": [
      "**/*",
      "!.env"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "target": "nsis"
    }
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "44.9.2",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1151.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@libsql/client": "^0.18.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "vis-network": "^10.1.0"
  }
}